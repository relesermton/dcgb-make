# generated by dcGCB v0.1.0 -- edit build.dcg, then run: dcgcb generate
ninja_required_version = 1.3

rule dcg_cxx
  deps = gcc
  depfile = $out.d
  command = g++ -std=c++20 -O2 -DNDEBUG -I../include -MP -MD -MF $out.d -c $in -o $out
  description = dcGCB compile $dcg_info

rule dcg_c
  deps = gcc
  depfile = $out.d
  command = gcc -std=c99 -O2 -DNDEBUG -I../include -MP -MD -MF $out.d -c $in -o $out
  description = dcGCB compile $dcg_info

build .dcgc/obj/combine_cxx_0.o: dcg_cxx .dcgc/gen/combine_cxx_0.cpp
  dcg_info = C++ combined chunk 0 (3 sources)
build .dcgc/obj/combine_c_0.o: dcg_c .dcgc/gen/combine_c_0.c
  dcg_info = C combined chunk 0 (1 sources)
rule dcg_link
  command = g++ $in -o $out -static-libgcc -static-libstdc++
  description = dcGCB output $out

build Demo.exe: dcg_link .dcgc/obj/combine_cxx_0.o .dcgc/obj/combine_c_0.o
default Demo.exe
